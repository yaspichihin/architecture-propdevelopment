        <mxCell id="sOx-MdOCgsYDNiw9nnzV-170" value="&lt;b&gt;Аналитическая &lt;/b&gt;информация&lt;br&gt;&lt;ul&gt;&lt;li&gt;Бизнес-аналитика без персональных данных&lt;/li&gt;&lt;li&gt;Отчетные данные в агрегированном виде&lt;/li&gt;&lt;li&gt;Информация о состоянии услуг ЖКХ&lt;/li&gt;&lt;li&gt;Данные об инфраструктуре&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=default;fillColor=default;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="sOx-MdOCgsYDNiw9nnzV-166">
