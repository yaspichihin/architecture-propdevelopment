        <mxCell id="sOx-MdOCgsYDNiw9nnzV-204" value="&lt;b&gt;Персональные данные клиентов&lt;br&gt;&lt;/b&gt;&lt;ul&gt;&lt;li&gt;ФИО и контактная информация&lt;/li&gt;&lt;li&gt;Паспортные данные&lt;/li&gt;&lt;li&gt;СНИЛС и ИНН&lt;/li&gt;&lt;li&gt;Сведения о семейном положении&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=default;fillColor=default;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="sOx-MdOCgsYDNiw9nnzV-203">
