        <mxCell id="sOx-MdOCgsYDNiw9nnzV-206" value="&lt;b&gt;Данные по сделкам&lt;br&gt;&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Договоры купли-продажи&lt;/li&gt;&lt;li&gt;Информация о бронировании&lt;/li&gt;&lt;li&gt;Сведения об электронной регистрации&lt;/li&gt;&lt;li&gt;Расчеты по сделкам&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=default;fillColor=default;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="sOx-MdOCgsYDNiw9nnzV-203">
