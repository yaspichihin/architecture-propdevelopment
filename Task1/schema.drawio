        <mxCell id="sOx-MdOCgsYDNiw9nnzV-155" value="&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;h2 style=&quot;line-height: 100%;&quot; class=&quot;mb-2 mt-4 font-semimedium text-base first:mt-0&quot;&gt;&lt;pre&gt;&lt;pre&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 16px;&quot;&gt;Информация о жилых комплексах&lt;br&gt;&lt;/font&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 16px; font-weight: normal;&quot;&gt;Наименование и адрес ЖК&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 16px; font-weight: normal;&quot;&gt;Стадия строительства и сроки сдачи&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 16px; font-weight: normal;&quot;&gt;Класс жилья и общее описание&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 16px; font-weight: normal;&quot;&gt;Фотографии и 3D-визуализация комплекса&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/pre&gt;&lt;/pre&gt;&lt;/h2&gt;&lt;/div&gt;" style="text;strokeColor=default;fillColor=default;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="sOx-MdOCgsYDNiw9nnzV-154">
