        <mxCell id="sOx-MdOCgsYDNiw9nnzV-167" value="&lt;b&gt;Технические данные&lt;br&gt;&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Журналы работы приложений&lt;/li&gt;&lt;li&gt;Логи API-запросов и ответов&lt;/li&gt;&lt;li&gt;Внутренние статусы сделок&lt;/li&gt;&lt;li&gt;Информация об ошибках системы&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=default;fillColor=default;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="sOx-MdOCgsYDNiw9nnzV-166">
