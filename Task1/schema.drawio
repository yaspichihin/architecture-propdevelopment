        <mxCell id="sOx-MdOCgsYDNiw9nnzV-201" value="&lt;b&gt;Контактные данные&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Телефоны центра обслуживания клиентов&lt;/li&gt;&lt;li&gt;Адреса офисов продаж&lt;/li&gt;&lt;li&gt;Официальная электронная почта&lt;/li&gt;&lt;li&gt;Контакты службы поддержки&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=default;fillColor=default;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=16;fontStyle=0" vertex="1" parent="sOx-MdOCgsYDNiw9nnzV-154">
